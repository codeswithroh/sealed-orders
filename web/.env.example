# Claude, used to compile plain-English orders and to run the AI commander
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Server wallet (base58 or JSON array). Pays base-layer rent so players need no SOL.
# Defaults to ~/.config/solana/id.json when unset.
SERVER_SECRET_KEY=
# Optional fixed key for the AI commander (generated into .ai-commander.json if unset)
AI_SECRET_KEY=
# crank (default): ticks scheduled inside the rollup. server: this process sends ticks.
TICK_MODE=crank
NEXT_PUBLIC_BASE_RPC=https://rpc.magicblock.app/devnet
NEXT_PUBLIC_TEE_URL=https://devnet-tee.magicblock.app
